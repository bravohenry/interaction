{
  "name": "@openpoke/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app:app --host 0.0.0.0 --port 8001 --reload",
    "build": "uv build",
    "start": "uv run uvicorn app:app --host 0.0.0.0 --port 8001",
    "format": "uv run ruff format .",
    "lint": "uv run ruff check .",
    "typecheck": "uv run mypy .",
    "clean": "rm -rf __pycache__ .mypy_cache .ruff_cache"
  }
}
